{
  "name": "glimmerwick-web",
  "private": true,
  "version": "0.1.0",
  "description": "Glimmerwick web client: Three.js renderer + UI host for the Rust/Bevy WASM simulation",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5173 --strictPort --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "lil-gui": "^0.21.0",
    "postprocessing": "^6.39.5",
    "stats-gl": "^4.2.3",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
